# =================================================================
# MARKET AI ENGINE - MẪU FILE CẤU HÌNH (.ENV.EXAMPLE)
# Copy file này thành .env và điền thông tin thực tế của bạn
# =================================================================

# 1. MÚI GIỜ HỆ THỐNG
TZ=Asia/Ho_Chi_Minh

# 2. CẤU HÌNH BÁO CÁO QUA TELEGRAM
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# 3. CẤU HÌNH BÁO CÁO QUA EMAIL (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=duypham@longvan.net,recipient_email@gmail.com

# 4. GEMINI AI API KEY (Phân tích chiến lược tự động)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 5. LỊCH CHẠY CÀO TỰ ĐỘNG (SCHEDULER)
CRAWL_INTERVAL_MINUTES=30
CRAWL_INTERVAL_SECONDS=0

# 6. THÔNG TIN CƠ SỞ DỮ LIỆU (MONGODB)
MONGO_URI=mongodb://localhost:27017/market_ai
MONGO_DB_NAME=market_ai

# 7. THÔNG TIN CƠ SỞ DỮ LIỆU CŨ (POSTGRESQL)
POSTGRES_DB=market_ai
POSTGRES_USER=market
POSTGRES_PASSWORD=your_db_password
